# Copy to .env or set these as environment variables. Nothing secret is hardcoded.
# PostgreSQL (recommended). If unset, a local SQLite file in backend/data is used.
DATABASE_URL=postgresql+psycopg://drcv:change-me@localhost:5432/drcv
# JWT signing key. If unset, a random key is generated once and stored in backend/data/.secret_key
DRCV_SECRET_KEY=replace-with-a-long-random-string
DRCV_MAX_UPLOAD_MB=20
DRCV_TOKEN_TTL_HOURS=12
